<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.cashier.ui.controller.ReceiptController"
      prefWidth="520" prefHeight="600" spacing="12"
      style="-fx-background-color: #f0f2f5; -fx-padding: 20;">

    <Label text="RECEIPT PREVIEW"
           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
    <Separator/>

    <TextArea fx:id="receiptText"
              editable="false"
              VBox.vgrow="ALWAYS"
              style="-fx-font-family: 'Courier New'; -fx-font-size: 12;
                     -fx-background-color: white; -fx-text-fill: #1a1a2e;
                     -fx-control-inner-background: white;
                     -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Print"    onAction="#onPrint"   prefWidth="120" prefHeight="38"
                style="-fx-background-color: #1565c0; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
        <Button text="Save PDF" onAction="#onSavePdf" prefWidth="130" prefHeight="38"
                style="-fx-background-color: #6a1b9a; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
        <Button text="Close"    onAction="#onClose"   prefWidth="90"  prefHeight="38"
                style="-fx-background-color: #757575; -fx-text-fill: white;
                       -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>
</VBox>
