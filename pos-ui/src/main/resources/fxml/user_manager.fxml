<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.cashier.ui.controller.UserManagerController"
            prefWidth="1100" prefHeight="720"
            style="-fx-background-color: #f0f2f5;">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-background-color: #1565c0; -fx-padding: 10 16 10 16;">
            <Button text="← Back" onAction="#onBack"
                    style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Label text="User Management"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="(Admin only)"
                   style="-fx-font-size: 12; -fx-text-fill: #bbdefb;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="14">
            <padding><Insets top="14" bottom="14" left="14" right="14"/></padding>

            <!-- User table -->
            <TableView fx:id="userTable" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                              -fx-background-radius: 8; -fx-border-radius: 8;">
                <columns>
                    <TableColumn fx:id="colUsername" text="Username"  prefWidth="160"/>
                    <TableColumn fx:id="colFullName" text="Full Name" prefWidth="180"/>
                    <TableColumn fx:id="colRole"     text="Role"      prefWidth="120"/>
                    <TableColumn fx:id="colStatus"   text="Last Login" prefWidth="160"/>
                </columns>
                <placeholder>
                    <Label text="No users found" style="-fx-text-fill: #9e9e9e;"/>
                </placeholder>
            </TableView>

            <!-- Form panel -->
            <VBox spacing="10" prefWidth="340"
                  style="-fx-background-color: white; -fx-background-radius: 8;
                         -fx-border-color: #e0e0e0; -fx-border-radius: 8;
                         -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                <Label text="Edit / Add User"
                       style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #1a1a2e;"/>
                <Separator/>

                <Label text="Username *" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                <TextField fx:id="fldUsername"
                           style="-fx-border-color: #ced4da; -fx-border-radius: 4;
                                  -fx-background-radius: 4; -fx-pref-height: 34;"/>

                <Label text="Full Name" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                <TextField fx:id="fldFullName"
                           style="-fx-border-color: #ced4da; -fx-border-radius: 4;
                                  -fx-background-radius: 4; -fx-pref-height: 34;"/>

                <Label text="Role *" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                <ChoiceBox fx:id="roleChoice" maxWidth="Infinity"
                           style="-fx-pref-height: 34;"/>

                <Separator/>

                <Label text="New Password" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                <Label text="(Leave blank to keep current password)"
                       style="-fx-text-fill: #9e9e9e; -fx-font-size: 10;"/>
                <PasswordField fx:id="fldPassword"
                               style="-fx-border-color: #ced4da; -fx-border-radius: 4;
                                      -fx-background-radius: 4; -fx-pref-height: 34;"/>

                <Label text="Confirm Password" style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                <PasswordField fx:id="fldConfirmPassword"
                               style="-fx-border-color: #ced4da; -fx-border-radius: 4;
                                      -fx-background-radius: 4; -fx-pref-height: 34;"/>

                <Separator/>

                <!-- Staff barcode badge preview -->
                <Label text="Staff Badge Barcode:"
                       style="-fx-text-fill: #6c757d; -fx-font-size: 11;"/>
                <VBox alignment="CENTER"
                      style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                             -fx-border-radius: 4; -fx-padding: 6;">
                    <ImageView fx:id="barcodePreview"
                               fitWidth="290" fitHeight="120" preserveRatio="true"/>
                </VBox>
                <Button text="Print Staff Badge" onAction="#onPrintBarcode"
                        maxWidth="Infinity" prefHeight="34"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="8">
                    <Button text="New"    onAction="#onNew"    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-background-color: #f5f5f5; -fx-text-fill: #1a1a2e;
                                   -fx-border-color: #bdbdbd; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    <Button text="Save"   onAction="#onSave"   HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    <Button text="Delete" onAction="#onDelete" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-background-color: #c62828; -fx-text-fill: white;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
