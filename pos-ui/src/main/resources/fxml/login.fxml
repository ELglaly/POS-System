<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.cashier.ui.controller.LoginController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color: #f0f2f5;">

    <!-- Header bar -->
    <HBox alignment="CENTER"
          style="-fx-background-color: #1565c0; -fx-padding: 20 32 20 32;">
        <Label text="CASHIER POS"
               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <!-- Login card -->
    <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox maxWidth="380" spacing="16"
              style="-fx-background-color: white;
                     -fx-padding: 36;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 16, 0, 0, 4);">

            <Label text="Sign In"
                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label text="Enter your credentials to continue"
                   style="-fx-font-size: 13; -fx-text-fill: #6c757d;"/>

            <Separator/>

            <!-- Username -->
            <VBox spacing="4">
                <Label text="Username" style="-fx-font-size: 12; -fx-text-fill: #495057; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Enter username"
                           onAction="#onLogin"
                           style="-fx-font-size: 14; -fx-pref-height: 40;
                                  -fx-background-color: white;
                                  -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;
                                  -fx-padding: 8 12 8 12;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="4">
                <Label text="Password" style="-fx-font-size: 12; -fx-text-fill: #495057; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" promptText="Enter password"
                               onAction="#onLogin"
                               style="-fx-font-size: 14; -fx-pref-height: 40;
                                      -fx-background-color: white;
                                      -fx-border-color: #ced4da; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-padding: 8 12 8 12;"/>
            </VBox>

            <!-- Error label -->
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: #c62828; -fx-font-size: 12;"
                   wrapText="true" managed="false" visible="false"/>

            <!-- Login button -->
            <Button text="Login" onAction="#onLogin"
                    maxWidth="Infinity" prefHeight="42"
                    style="-fx-background-color: #1565c0; -fx-text-fill: white;
                           -fx-font-size: 15; -fx-font-weight: bold;
                           -fx-background-radius: 5; -fx-cursor: hand;"/>

            <Separator/>

            <!-- Barcode scan section -->
            <VBox spacing="6">
                <Label text="Or scan your staff barcode"
                       style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                <HBox spacing="8">
                    <TextField fx:id="barcodeField" promptText="Scan barcode here..."
                               onAction="#onBarcodeLogin"
                               HBox.hgrow="ALWAYS"
                               style="-fx-font-size: 13; -fx-pref-height: 36;
                                      -fx-background-color: #f8f9fa;
                                      -fx-border-color: #adb5bd; -fx-border-radius: 5; -fx-background-radius: 5;
                                      -fx-padding: 6 10 6 10;"/>
                    <Button text="Scan Login" onAction="#onBarcodeLogin"
                            prefHeight="36"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white;
                                   -fx-font-size: 13; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
        <padding><Insets top="40" bottom="40"/></padding>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER"
          style="-fx-background-color: #e9ecef; -fx-padding: 10;">
        <Label text="POS Pro — Point of Sale System"
               style="-fx-font-size: 11; -fx-text-fill: #6c757d;"/>
    </HBox>
</VBox>
